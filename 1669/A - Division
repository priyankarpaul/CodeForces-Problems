bool binarySearch(vector<ll>& s,ll target){
    ll n=s.size();
    ll low=0;
    ll high=n-1;
    while(low<=high){
        ll mid=low+(high-low)/2;
        if(s[mid]==target) return true;
        else if(s[mid]<target) low=mid+1;
        else high=mid-1;
    }
    return false;
}
 
