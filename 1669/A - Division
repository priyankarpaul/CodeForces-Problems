ll gcd1(ll a,ll b){
    while(b!=0){
        ll temp=b;
        b=a%b;
        a=temp;
    }
    return a;
}
 
ll lcm1(ll a,ll b){
    if(a==0||b==0) return 0;
    return (a/gcd1(a,b))*b;
}
 
