#include <bits/stdc++.h>
using namespace std;
 
#define ll              long long 
#define ff              first
#define ss              second
#define pb              push_back
const ll MOD = 1e9+7;
 
void solve(){
    ll n,m,k;
    cin>>n>>m>>k;
 
    vector<ll> rowLimits(m+1,1e18);
 
    for(int i=0;i<n;i++){
        ll r,c;
        cin>>r>>c;
        rowLimits[r]=min(rowLimits[r],c);
    }
 
    ll total=0;
    for(int i=1;i<=m;i++){
        total+=rowLimits[i];
    }
    
    cout<<min(total,k)<<"
";
}
int main(){
    ios_base::sync_with_stdio(0); cin.tie(0); cout.tie(0);
    int t=1;
    //cin>>t;
    while(t--){
        solve();
    }
    return 0;
}